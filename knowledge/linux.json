{
  "category": "linux",
  "entries": [
    {
      "name": "ls",
      "kind": "command",
      "summary": "Lista arquivos e diretórios",
      "usage": "ls [OPÇÕES] [CAMINHO...]",
      "aliases": ["listar arquivos", "list files", "ver arquivos", "conteúdo do diretório", "dir"],
      "tags": ["arquivos", "diretórios", "files"],
      "options": [
        { "short": "-l", "description": "Formato longo: permissões, dono, tamanho e data" },
        { "short": "-a", "long": "--all", "description": "Inclui arquivos ocultos (começam com .)" },
        { "short": "-A", "long": "--almost-all", "description": "Como -a, mas sem . e .." },
        { "short": "-h", "long": "--human-readable", "description": "Tamanhos legíveis (K, M, G) junto com -l" },
        { "short": "-t", "description": "Ordena por data de modificação, mais recentes primeiro" },
        { "short": "-S", "description": "Ordena por tamanho, maiores primeiro" },
        { "short": "-r", "long": "--reverse", "description": "Inverte a ordenação" },
        { "short": "-R", "long": "--recursive", "description": "Lista subdiretórios recursivamente" },
        { "short": "-d", "long": "--directory", "description": "Mostra o próprio diretório, não o conteúdo" },
        { "short": "-1", "description": "Um arquivo por linha" },
        { "short": "-i", "long": "--inode", "description": "Mostra o número do inode" }
      ],
      "arguments": [{ "name": "CAMINHO", "kind": "path", "description": "Arquivo ou diretório a listar (padrão: diretório atual)", "repeat": true }],
      "examples": [
        { "command": "ls -la", "description": "Tudo, inclusive ocultos, em formato longo" },
        { "command": "ls -lh /var/log", "description": "Tamanhos legíveis em /var/log" },
        { "command": "ls -lt", "description": "Mais recentes primeiro" },
        { "command": "ls -lS", "description": "Maiores primeiro" },
        { "command": "ls -ld */", "description": "Apenas os diretórios" }
      ],
      "related": ["cd", "stat", "find", "permissions", "du"]
    },
    {
      "name": "cd",
      "kind": "command",
      "summary": "Muda o diretório atual",
      "description": "Comando interno do shell (builtin). cd sem argumentos vai para o home; cd - volta ao diretório anterior.",
      "usage": "cd [DIRETÓRIO]",
      "aliases": ["mudar diretório", "trocar de pasta", "entrar na pasta", "change directory"],
      "tags": ["diretórios", "navegação", "builtin"],
      "arguments": [{ "name": "DIRETÓRIO", "kind": "path", "description": "Destino (padrão: $HOME)" }],
      "examples": [
        { "command": "cd /var/log", "description": "Caminho absoluto" },
        { "command": "cd ..", "description": "Sobe um nível" },
        { "command": "cd -", "description": "Volta ao diretório anterior" },
        { "command": "cd ~/projetos", "description": "Relativo ao home" }
      ],
      "related": ["pwd", "ls", "environment-variables"]
    },
    {
