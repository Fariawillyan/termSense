    {
      "name": "cp",
      "kind": "command",
      "summary": "Copia arquivos e diretórios",
      "usage": "cp [OPÇÕES] ORIGEM... DESTINO",
      "aliases": ["copiar arquivo", "copiar pasta", "copy", "duplicar arquivo"],
      "tags": ["arquivos", "cópia"],
      "options": [
        { "short": "-r", "long": "--recursive", "description": "Copia diretórios recursivamente" },
        { "short": "-a", "long": "--archive", "description": "Preserva permissões, datas e links (implica -r)" },
        { "short": "-i", "long": "--interactive", "description": "Pergunta antes de sobrescrever" },
        { "short": "-n", "long": "--no-clobber", "description": "Nunca sobrescreve" },
        { "short": "-v", "long": "--verbose", "description": "Mostra cada arquivo copiado" },
        { "short": "-u", "long": "--update", "description": "Só copia se a origem for mais nova" }
      ],
      "arguments": [
        { "name": "ORIGEM", "kind": "path", "description": "O que copiar" },
        { "name": "DESTINO", "kind": "path", "description": "Arquivo ou diretório de destino", "repeat": true }
      ],
      "examples": [
        { "command": "cp app.conf app.conf.bak", "description": "Cópia de segurança de um arquivo" },
        { "command": "cp -r src/ backup/", "description": "Copia um diretório inteiro" },
        { "command": "cp -a /etc/nginx ~/nginx-backup", "description": "Cópia preservando permissões e datas" },
        { "command": "cp -iv *.txt docs/", "description": "Pergunta antes de sobrescrever e mostra o progresso" }
      ],
      "related": ["mv", "scp", "globbing"]
    },
