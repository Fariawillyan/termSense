    {
      "name": "find",
      "kind": "command",
      "summary": "Procura arquivos por nome, tipo, tamanho, data e permissões",
      "description": "Percorre a árvore de diretórios a partir de CAMINHO avaliando expressões. As opções de find usam um único hífen (-name, -type). N em -mtime: -1 = menos de 1 dia, +7 = mais de 7 dias.",
      "usage": "find [CAMINHO...] [EXPRESSÃO]",
      "aliases": ["procurar arquivo", "encontrar arquivos", "buscar arquivo", "localizar arquivo", "find files", "search files"],
      "tags": ["arquivos", "busca"],
      "options": [
        { "short": "-name", "arg": "PADRÃO", "description": "Nome com glob (ex.: '*.log'); use aspas" },
        { "short": "-iname", "arg": "PADRÃO", "description": "Como -name, sem diferenciar maiúsculas" },
        { "short": "-type", "arg": "TIPO", "description": "f arquivo, d diretório, l link simbólico" },
        { "short": "-mtime", "arg": "N", "description": "Modificado há N dias (-1 menos de um dia, +7 mais de sete)" },
        { "short": "-mmin", "arg": "N", "description": "Modificado há N minutos" },
        { "short": "-newer", "arg": "ARQUIVO", "description": "Modificado depois de ARQUIVO" },
        { "short": "-size", "arg": "N", "description": "Tamanho (+100M maior que 100 MiB, -1k menor que 1 KiB)" },
        { "short": "-user", "arg": "USUÁRIO", "description": "Pertence ao usuário" },
        { "short": "-perm", "arg": "MODO", "description": "Com as permissões informadas" },
        { "short": "-maxdepth", "arg": "N", "description": "Desce no máximo N níveis" },
        { "short": "-empty", "description": "Arquivos ou diretórios vazios" },
        { "short": "-path", "arg": "PADRÃO", "description": "Caminho completo casa com o glob" },
        { "short": "-not", "description": "Nega o teste seguinte (equivale a !)" },
        { "short": "-o", "description": "OU lógico entre testes" },
        { "short": "-exec", "arg": "COMANDO", "description": "Executa COMANDO para cada resultado ({} é o arquivo; termina com \\; ou +)" },
        { "short": "-delete", "description": "Apaga os arquivos encontrados (cuidado)" },
        { "short": "-print0", "description": "Separa resultados com NUL, para xargs -0" },
        { "short": "-prune", "description": "Não desce no diretório que casou" },
        { "short": "-xdev", "description": "Não atravessa para outros sistemas de arquivos" }
      ],
      "arguments": [{ "name": "CAMINHO", "kind": "path", "description": "Onde começar a busca (padrão: .)", "repeat": true }],
      "examples": [
        { "command": "find . -name '*.log'", "description": "Arquivos .log a partir do diretório atual" },
        { "command": "find . -type f -mtime -1", "description": "Arquivos modificados nas últimas 24 horas" },
        { "command": "find /var/log -type f -size +100M", "description": "Arquivos maiores que 100 MiB" },
        { "command": "find . -type d -name node_modules -prune", "description": "Localiza diretórios node_modules" },
        { "command": "find . -type f -name '*.tmp' -delete", "description": "Apaga temporários (confira antes sem -delete)" },
        { "command": "find . -name '*.sh' -exec chmod +x {} +", "description": "Executa um comando para os resultados" },
        { "command": "find . -type f -print0 | xargs -0 grep -l TODO", "description": "Combina com xargs de forma segura para espaços" }
      ],
      "related": ["locate", "xargs", "grep", "globbing", "find-modified-files"]
    },
    {
      "name": "xargs",
      "kind": "command",
      "summary": "Constrói e executa comandos com itens lidos da entrada padrão",
      "description": "Transforma linhas do stdin em argumentos de outro comando. Útil depois de find, grep -l e ls.",
      "usage": "xargs [OPÇÕES] [COMANDO [ARGUMENTOS]]",
      "wrapper": true,
      "aliases": ["argumentos da entrada", "executar para cada linha", "for each line"],
      "tags": ["shell", "pipe"],
      "options": [
        { "short": "-0", "long": "--null", "description": "Itens separados por NUL (par de find -print0)" },
        { "short": "-n", "long": "--max-args", "arg": "N", "description": "No máximo N argumentos por execução" },
        { "short": "-I", "arg": "MARCADOR", "description": "Substitui MARCADOR (ex.: {}) por cada item" },
        { "short": "-P", "long": "--max-procs", "arg": "N", "description": "Executa até N processos em paralelo" },
        { "short": "-r", "long": "--no-run-if-empty", "description": "Não executa se não houver entrada" },
        { "short": "-t", "long": "--verbose", "description": "Mostra cada comando antes de executar" }
      ],
      "examples": [
        { "command": "find . -name '*.log' -print0 | xargs -0 rm", "description": "Remove os arquivos encontrados" },
        { "command": "grep -l TODO -r src | xargs -r wc -l", "description": "Conta linhas dos arquivos com TODO" },
        { "command": "cat hosts.txt | xargs -I{} ping -c1 {}", "description": "Um ping por host da lista" },
        { "command": "ls *.png | xargs -P 4 -I{} convert {} {}.jpg", "description": "Converte em paralelo (4 processos)" }
      ],
      "related": ["find", "pipe", "stdin"]
    },
    {
      "name": "chmod",
      "kind": "command",
      "summary": "Altera permissões de arquivos e diretórios",
      "description": "Modo simbólico: u (dono), g (grupo), o (outros), a (todos) com + - = e r w x. Modo octal: r=4, w=2, x=1 somados por dono/grupo/outros (755 = rwxr-xr-x).",
      "usage": "chmod [OPÇÕES] MODO ARQUIVO...",
      "aliases": ["mudar permissão", "alterar permissões", "dar permissão de execução", "tornar executável", "change mode"],
      "tags": ["permissões", "arquivos", "segurança"],
      "options": [
        { "short": "-R", "long": "--recursive", "description": "Aplica em diretórios recursivamente" },
        { "short": "-v", "long": "--verbose", "description": "Mostra cada alteração" }
      ],
      "arguments": [
        { "name": "MODO", "kind": "text", "description": "Permissões em octal (644) ou simbólicas (u+x)" },
        { "name": "ARQUIVO", "kind": "path", "description": "Arquivos a alterar", "repeat": true }
