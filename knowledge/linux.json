    {
      "name": "less",
      "kind": "command",
      "summary": "Visualiza arquivos longos com rolagem e busca",
      "description": "Dentro do less: / busca, n próxima ocorrência, g início, G fim, F segue o arquivo (como tail -f), q sai.",
      "usage": "less [OPÇÕES] ARQUIVO",
