{
  "category": "regex",
  "entries": [
    {
      "id": "regex",
      "name": "Regex",
      "kind": "concept",
      "summary": "Expressões regulares: padrões para buscar, validar e extrair texto",
      "description": "Digite regex seguido de um padrão (ex.: regex ^[0-9]+$) para ver a análise token a token, a interpretação e exemplos que casam e que não casam.",
      "aliases": ["expressão regular", "expressões regulares", "regular expression", "regexp", "padrão de texto"],
      "tags": ["regex", "texto", "busca"],
      "sections": [
        {
          "title": "Referência rápida",
          "rows": [
            ["^", "início"],
            ["$", "fim"],
            [".", "qualquer caractere"],
            ["*", "zero ou mais"],
            ["+", "um ou mais"],
            ["?", "zero ou um"],
            ["{n,m}", "entre n e m vezes"],
            ["[]", "classe de caracteres"],
            ["[^]", "classe negada"],
            ["()", "grupo"],
            ["(?:)", "grupo não capturante"],
            ["|", "alternância"],
            ["\\d", "dígito"],
            ["\\w", "caractere de palavra"],
            ["\\s", "espaço"],
            ["\\b", "limite de palavra"]
          ]
        }
      ],
      "examples": [
        { "command": "grep -E '^[0-9]+$' arquivo.txt", "description": "Linhas só com números" },
        { "command": "grep -oE '[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}' contatos.txt", "description": "Extrai e-mails" },
        { "command": "sed -E 's/[[:space:]]+$//' arquivo.txt", "description": "Remove espaços no fim das linhas" }
      ],
      "related": ["regex-anchors", "regex-classes", "regex-quantifiers", "regex-groups", "regex-alternation", "regex-flavors", "grep", "sed"]
    },
    {
      "id": "regex-anchors",
      "name": "Regex: âncoras e limites",
      "kind": "concept",
      "summary": "Posições no texto: início, fim e limites de palavra",
      "description": "Âncoras não consomem caracteres, apenas exigem uma posição. Sem âncoras, o padrão pode casar em qualquer lugar da linha.",
      "aliases": ["âncora", "anchors", "início da linha", "fim da linha", "limite de palavra", "word boundary"],
      "tags": ["regex"],
      "sections": [
        {
          "title": "Âncoras",
          "rows": [["^", "início da string ou linha"], ["$", "fim da string ou linha"], ["\\b", "limite de palavra"], ["\\B", "fora de limite de palavra"], ["\\A \\z", "início e fim absolutos do texto"]]
        }
      ],
      "examples": [
        { "command": "grep '^#' config.ini", "description": "Linhas que começam com #" },
        { "command": "grep -E '\\.log$' lista.txt", "description": "Linhas que terminam em .log" },
        { "command": "grep -w 'erro' app.log", "description": "Palavra inteira (equivale a \\berro\\b)" },
        { "command": "grep -v '^$' arquivo.txt", "description": "Remove linhas vazias" }
      ],
      "related": ["regex", "regex-classes", "grep"]
    },
    {
      "id": "regex-classes",
      "name": "Regex: classes de caracteres",
      "kind": "concept",
      "summary": "Conjuntos de caracteres aceitos em uma posição",
      "description": "Uma classe casa exatamente um caractere. Dentro de [], ^ no início nega a classe e - forma intervalos. Classes POSIX como [[:digit:]] funcionam em grep e sed; \\d, \\w e \\s são de Perl/PCRE.",
      "aliases": ["classe de caracteres", "character class", "colchetes", "[0-9]", "[a-z]", "\\d", "\\w", "\\s", "posix"],
      "tags": ["regex"],
      "sections": [
        {
          "title": "Classes",
          "rows": [
            ["[abc]", "a, b ou c"],
            ["[^abc]", "qualquer um exceto a, b e c"],
            ["[a-z]", "letra minúscula"],
            ["[0-9] \\d", "dígito"],
            ["\\w", "letra, dígito ou _"],
            ["\\s", "espaço, tab, quebra de linha"],
            ["\\D \\W \\S", "negações de \\d \\w \\s"],
            ["[[:alpha:]]", "letra (POSIX)"],
            ["[[:space:]]", "espaço em branco (POSIX)"],
            [".", "qualquer caractere exceto quebra de linha"]
          ]
        }
      ],
      "examples": [
        { "command": "grep -E '[0-9]{3}-[0-9]{4}' contatos.txt", "description": "Padrões como 555-1234" },
        { "command": "grep -E '[^[:print:]]' arquivo.txt", "description": "Linhas com caracteres invisíveis" }
      ],
      "related": ["regex", "regex-quantifiers", "globbing"]
    },
    {
      "id": "regex-quantifiers",
      "name": "Regex: quantificadores",
      "kind": "concept",
      "summary": "Quantas vezes o elemento anterior pode se repetir",
      "description": "Quantificadores são gulosos: casam o máximo possível. Com ? depois (*?, +?) ficam preguiçosos e casam o mínimo (PCRE e crate regex; não em grep -E).",
      "aliases": ["quantificador", "quantifiers", "repetição", "*", "+", "?", "{n,m}", "guloso", "greedy", "lazy"],
      "tags": ["regex"],
      "sections": [
        {
          "title": "Quantificadores",
          "rows": [["*", "zero ou mais"], ["+", "um ou mais"], ["?", "zero ou um"], ["{3}", "exatamente 3"], ["{2,}", "2 ou mais"], ["{2,5}", "de 2 a 5"], ["*? +?", "versões preguiçosas"]]
        }
      ],
      "examples": [
        { "command": "grep -E 'go+gle' arquivo.txt", "description": "gogle, google, gooogle..." },
        { "command": "grep -E '^[0-9]{5}-?[0-9]{3}$' ceps.txt", "description": "CEP com hífen opcional" }
      ],
      "related": ["regex", "regex-classes", "regex-groups"]
    },
    {
      "id": "regex-groups",
      "name": "Regex: grupos e retrorreferências",
      "kind": "concept",
      "summary": "Agrupam partes do padrão para quantificar, alternar ou capturar",
      "description": "(...) captura o trecho, que pode ser reutilizado na substituição (\\1 no sed, $1 em outras linguagens). (?:...) agrupa sem capturar. (?P<nome>...) dá nome ao grupo. Retrorreferências dentro do próprio padrão (\\1) exigem BRE/PCRE; a crate regex não suporta.",
      "aliases": ["grupo de captura", "capture group", "parênteses", "retrorreferência", "backreference", "(?:)", "named group"],
      "tags": ["regex"],
      "examples": [
        { "command": "sed -E 's/(\\w+) (\\w+)/\\2 \\1/' nomes.txt", "description": "Inverte duas palavras usando os grupos" },
        { "command": "grep -E '(ab)+' arquivo.txt", "description": "ab, abab, ababab..." },
        { "command": "grep -P '(\\w+) \\1' texto.txt", "description": "Palavras repetidas (retrorreferência, PCRE)" }
      ],
      "related": ["regex", "regex-alternation", "regex-quantifiers", "sed"]
    },
    {
      "id": "regex-alternation",
      "name": "Regex: alternância",
      "kind": "concept",
      "summary": "Casa uma entre várias alternativas com |",
      "description": "| tem a menor precedência: ^a|b$ significa (^a) ou (b$). Use grupos para limitar: ^(a|b)$.",
      "aliases": ["alternância", "alternation", "ou", "|", "pipe regex"],
      "tags": ["regex"],
      "examples": [
        { "command": "grep -E 'ERROR|FATAL' app.log", "description": "Linhas com ERROR ou FATAL" },
        { "command": "grep -E '^(GET|POST) ' access.log", "description": "Requisições GET ou POST" }
      ],
      "related": ["regex", "regex-groups"]
    },
    {
      "id": "regex-flavors",
      "name": "Regex: BRE, ERE e PCRE",
      "kind": "concept",
      "summary": "Os dialetos de regex no Linux e o que muda entre eles",
      "description": "BRE (grep, sed sem -E): + ? | ( ) { } são literais e precisam de \\ para virar operadores. ERE (grep -E, sed -E, awk): operadores sem barra. PCRE (grep -P): acrescenta \\d, lookahead, lookbehind e quantificadores preguiçosos. A crate regex do Rust é próxima de ERE + \\d/\\w, sem lookaround nem retrorreferências.",
      "aliases": ["bre", "ere", "pcre", "egrep", "grep -E", "grep -P", "dialetos de regex", "regex flavors"],
      "tags": ["regex", "grep", "sed"],
      "sections": [
        {
          "title": "Um ou mais dígitos em cada dialeto",
          "rows": [["BRE", "grep '[0-9]\\+'"], ["ERE", "grep -E '[0-9]+'"], ["PCRE", "grep -P '\\d+'"]]
        }
      ],
      "examples": [
        { "command": "grep 'a\\+' arquivo.txt", "description": "BRE: + precisa de barra" },
        { "command": "grep -E 'a+' arquivo.txt", "description": "ERE: + é operador" },
        { "command": "grep -P '\\d+(?= reais)' valores.txt", "description": "PCRE: lookahead" }
      ],
      "related": ["regex", "grep", "sed", "awk"]
    },
    {
      "id": "regex-email",
      "name": "Regex: e-mail",
      "kind": "recipe",
      "summary": "Padrão prático para encontrar ou validar endereços de e-mail",
      "description": "Nenhuma regex valida 100% dos e-mails possíveis; esta cobre os formatos usuais.",
      "aliases": ["regex email", "validar email", "extrair emails", "email regex"],
      "tags": ["regex", "validação"],
      "examples": [
        { "command": "grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}' arquivo.txt", "description": "Extrai e-mails" },
        { "command": "grep -E '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$' lista.txt", "description": "Linhas que são exatamente um e-mail" }
      ],
      "related": ["regex", "grep"]
    },
    {
      "id": "regex-ipv4",
      "name": "Regex: endereço IPv4",
      "kind": "recipe",
      "summary": "Padrão para encontrar endereços IPv4 em textos e logs",
      "description": "A forma simples aceita valores como 999.1.1.1; para validar faixas 0–255 use a forma estrita.",
      "aliases": ["regex ip", "regex ipv4", "extrair ips", "encontrar ip no log"],
      "tags": ["regex", "rede", "logs"],
      "examples": [
        { "command": "grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}' access.log", "description": "Extrai IPs (forma simples)" },
        { "command": "grep -oE '((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])' access.log", "description": "Forma estrita (0–255)" },
        { "command": "grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}' access.log | sort | uniq -c | sort -rn", "description": "IPs mais frequentes" }
      ],
      "related": ["regex", "ipv4", "grep", "count-occurrences"]
    },
    {
      "id": "regex-date",
      "name": "Regex: data AAAA-MM-DD",
      "kind": "recipe",
      "summary": "Padrão para datas no formato ISO 8601",
      "aliases": ["regex data", "regex date", "extrair datas", "data iso"],
      "tags": ["regex", "validação"],
      "examples": [
        { "command": "grep -oE '[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])' app.log", "description": "Extrai datas ISO" },
        { "command": "grep -E '^2024-03-' app.log", "description": "Linhas de março de 2024" }
      ],
      "related": ["regex", "grep"]
    },
    {
      "id": "regex-uuid",
      "name": "Regex: UUID",
      "kind": "recipe",
      "summary": "Padrão para identificadores UUID",
      "aliases": ["regex uuid", "extrair uuid", "guid"],
      "tags": ["regex"],
      "examples": [
        { "command": "grep -oiE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' app.log", "description": "Extrai UUIDs" }
      ],
      "related": ["regex", "grep"]
    },
    {
      "id": "regex-blank-lines",
      "name": "Regex: linhas vazias e comentários",
      "kind": "recipe",
      "summary": "Remover linhas em branco e comentários de arquivos de configuração",
      "aliases": ["remover linhas vazias", "linhas em branco", "remover comentários", "config sem comentários"],
      "tags": ["regex", "texto", "configuração"],
      "examples": [
        { "command": "grep -Ev '^[[:space:]]*(#|$)' nginx.conf", "description": "Só as linhas ativas" },
        { "command": "sed -E '/^[[:space:]]*$/d' arquivo.txt", "description": "Remove linhas vazias" }
      ],
      "related": ["regex", "grep", "sed"]
    }
  ]
}
