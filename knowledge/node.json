{
  "category": "node",
  "entries": [
    {
      "name": "node",
      "kind": "command",
      "summary": "Executa JavaScript fora do navegador (Node.js)",
      "usage": "node [OPÇÕES] [ARQUIVO.js] [ARGS]",
      "install": "Prefira o nvm, que instala a versão que o projeto pede (o pacote nodejs das distribuições costuma ser antigo).",
      "aliases": ["nodejs", "node.js", "rodar javascript", "javascript no terminal"],
      "tags": ["node", "javascript"],
      "options": [
        { "short": "-v", "long": "--version", "description": "Versão do Node" },
        { "short": "-e", "long": "--eval", "arg": "CÓDIGO", "description": "Executa um trecho de JavaScript" },
        { "long": "--watch", "description": "Reinicia ao salvar arquivos (Node 18.11+)" },
        { "long": "--inspect", "arg": "[HOST:]PORTA", "description": "Abre o depurador (Chrome DevTools, VS Code) na porta 9229" },
        { "long": "--inspect-brk", "arg": "[HOST:]PORTA", "description": "Como --inspect, parando na primeira linha" },
        { "long": "--env-file", "arg": "ARQUIVO", "description": "Carrega variáveis de um .env (Node 20.6+)" },
        { "short": "-r", "long": "--require", "arg": "MÓDULO", "description": "Carrega um módulo antes do programa" },
        { "long": "--max-old-space-size", "arg": "MB", "description": "Heap máximo do V8, em MB" }
      ],
      "examples": [
        { "command": "node app.js", "description": "Roda um arquivo" },
        { "command": "node -v", "description": "Versão" },
        { "command": "node -e 'console.log(process.versions)'", "description": "Versões do Node, V8 e OpenSSL" },
        { "command": "node --watch server.js", "description": "Reinicia ao salvar" },
        { "command": "node --inspect-brk app.js", "description": "Depura desde a primeira linha" },
        { "command": "node --env-file=.env app.js", "description": "Com as variáveis do .env" },
        { "command": "NODE_OPTIONS=--max-old-space-size=4096 npm run build", "description": "Mais memória para um build pesado" }
      ],
      "related": ["npm", "nvm", "npx"]
    },
    {
      "name": "npm",
      "kind": "command",
      "summary": "Gerenciador de pacotes do Node: instala dependências e roda os scripts do projeto",
      "description": "Lê o package.json da pasta atual. As dependências vão para node_modules/ e as versões exatas ficam no package-lock.json.",
      "usage": "npm SUBCOMANDO [OPÇÕES]",
      "aliases": ["node package manager", "gerenciador de pacotes javascript", "npm run", "npm install"],
      "tags": ["node", "javascript", "pacotes"],
      "options": [
        { "short": "-g", "long": "--global", "description": "Pacote global (ferramenta de linha de comando), não do projeto" },
        { "short": "-w", "long": "--workspace", "arg": "NOME", "description": "Aplica a um workspace de um monorepo" },
        { "long": "--loglevel", "arg": "NÍVEL", "description": "silent, error, warn, info, verbose" },
        { "short": "-y", "long": "--yes", "description": "Aceita as perguntas" },
        { "short": "-v", "long": "--version", "description": "Versão do npm" }
      ],
      "examples": [
        { "command": "npm install", "description": "Instala as dependências do package.json" },
        { "command": "npm ci", "description": "Instalação limpa e exata (CI)" },
        { "command": "npm run build", "description": "Roda o script build" },
        { "command": "npm run", "description": "Lista os scripts do projeto" },
        { "command": "npm test", "description": "Roda os testes" },
        { "command": "npm outdated", "description": "Pacotes com versão mais nova" }
      ],
      "related": ["node", "npx", "package-json", "semver", "nvm"]
    },
    {
      "id": "npm-install",
      "name": "npm install",
      "kind": "command",
      "parent": "npm",
      "summary": "Instala as dependências do package.json, ou adiciona um pacote",
      "aliases": ["npm i", "npm add", "instalar pacote npm", "adicionar dependência", "npm install"],
      "options": [
        { "short": "-D", "long": "--save-dev", "description": "Adiciona como dependência de desenvolvimento (devDependencies)" },
        { "short": "-E", "long": "--save-exact", "description": "Grava a versão exata, sem ^" },
        { "long": "--omit", "arg": "TIPO", "description": "Não instala um tipo: --omit=dev para produção" },
        { "long": "--legacy-peer-deps", "description": "Ignora conflitos de peer dependencies (comportamento do npm 6)" },
        { "long": "--no-save", "description": "Instala sem alterar o package.json" }
      ],
      "arguments": [
        { "name": "PACOTE", "kind": "text", "description": "nome, nome@versão, nome@^1.2, caminho ou URL git", "repeat": true }
      ],
      "examples": [
        { "command": "npm install", "description": "Tudo do package.json" },
        { "command": "npm i express", "description": "Adiciona uma dependência" },
        { "command": "npm i -D typescript vitest", "description": "Dependências de desenvolvimento" },
        { "command": "npm i lodash@4.17.21 -E", "description": "Versão exata" },
        { "command": "npm i -g pnpm", "description": "Ferramenta global" },
        { "command": "npm install --legacy-peer-deps", "description": "Contorna ERESOLVE de peer dependencies" }
      ],
      "related": ["npm-ci", "npm-uninstall", "semver", "error-npm-eresolve"]
    },
    {
      "id": "npm-ci",
      "name": "npm ci",
      "kind": "command",
      "parent": "npm",
      "summary": "Instalação limpa e exata a partir do package-lock.json (CI e builds)",
      "description": "Apaga node_modules e instala exatamente o que está no lockfile; falha se o package.json e o lock divergirem. É o comando certo para CI e Docker.",
      "aliases": ["npm clean install", "instalação limpa npm"],
      "options": [
        { "long": "--omit", "arg": "TIPO", "description": "--omit=dev instala só o necessário para rodar" }
      ],
      "examples": [
        { "command": "npm ci", "description": "Instalação reproduzível" },
        { "command": "npm ci --omit=dev", "description": "Para a imagem de produção" }
      ],
      "related": ["npm-install", "lockfile"]
    },
    {
      "id": "npm-run",
      "name": "npm run",
      "kind": "command",
      "parent": "npm",
      "summary": "Roda um script do package.json",
      "description": "Sem argumentos, lista os scripts. Argumentos depois de -- vão para o script. Os binários de node_modules/.bin entram no PATH do script.",
      "aliases": ["npm run-script", "rodar script npm", "npm scripts"],
      "arguments": [
        { "name": "SCRIPT", "kind": "text", "description": "Nome do script (build, dev, lint...)" },
        { "name": "ARGS", "kind": "text", "description": "Argumentos depois de -- vão para o script", "repeat": true }
      ],
      "examples": [
        { "command": "npm run", "description": "Lista os scripts" },
        { "command": "npm run build", "description": "Roda o build" },
        { "command": "npm run dev", "description": "Servidor de desenvolvimento (por convenção)" },
        { "command": "npm run test -- --watch", "description": "Repassa --watch ao script" },
        { "command": "npm run build --workspace=web", "description": "Em um workspace do monorepo" }
      ],
      "related": ["package-json", "npm-test", "error-npm-missing-script"]
    },
    {
      "id": "npm-test",
      "name": "npm test",
      "kind": "command",
      "parent": "npm",
      "summary": "Roda o script test do package.json",
      "aliases": ["npm t", "testes node", "rodar testes javascript"],
      "examples": [
        { "command": "npm test", "description": "Todos os testes" },
        { "command": "npm test -- -t 'calcula total'", "description": "Repassa um filtro ao Jest/Vitest" }
      ],
      "related": ["npm-run"]
    },
    {
      "id": "npm-start",
      "name": "npm start",
      "kind": "command",
      "parent": "npm",
      "summary": "Roda o script start (ou node server.js, se não houver)",
      "examples": [
        { "command": "npm start", "description": "Sobe a aplicação" }
      ],
      "related": ["npm-run"]
    },
    {
      "id": "npm-init",
      "name": "npm init",
      "kind": "command",
      "parent": "npm",
      "summary": "Cria um package.json (ou um projeto a partir de um modelo)",
      "aliases": ["criar package.json", "novo projeto node", "npm create"],
      "examples": [
        { "command": "npm init -y", "description": "package.json com valores padrão" },
        { "command": "npm create vite@latest", "description": "Projeto a partir de um modelo" }
      ],
      "related": ["package-json"]
    },
    {
      "id": "npm-uninstall",
      "name": "npm uninstall",
      "kind": "command",
      "parent": "npm",
      "summary": "Remove um pacote e tira do package.json",
      "aliases": ["npm rm", "npm remove", "remover pacote npm"],
      "examples": [
        { "command": "npm uninstall lodash", "description": "Remove a dependência" },
        { "command": "npm uninstall -g pacote", "description": "Remove uma ferramenta global" }
      ],
      "related": ["npm-install"]
    },
    {
      "id": "npm-ls",
      "name": "npm ls",
      "kind": "command",
      "parent": "npm",
      "summary": "Mostra a árvore de dependências instaladas",
      "aliases": ["npm list", "dependências instaladas", "quem depende deste pacote"],
      "options": [
        { "long": "--depth", "arg": "N", "description": "Profundidade" },
        { "long": "--all", "description": "Toda a árvore" }
      ],
      "examples": [
        { "command": "npm ls", "description": "Dependências diretas" },
        { "command": "npm ls react", "description": "Quais versões de react existem e quem as traz" },
        { "command": "npm ls --all", "description": "Árvore completa" }
      ],
      "related": ["npm-outdated", "error-npm-eresolve"]
    },
    {
      "id": "npm-outdated",
      "name": "npm outdated",
      "kind": "command",
      "parent": "npm",
      "summary": "Lista pacotes com versões mais novas (Current, Wanted, Latest)",
      "description": "Wanted é a maior versão que a faixa do package.json aceita; Latest é a mais nova publicada.",
      "aliases": ["pacotes desatualizados", "atualizações npm"],
      "examples": [
        { "command": "npm outdated", "description": "O que pode ser atualizado" }
      ],
      "related": ["npm-update", "semver"]
    },
    {
      "id": "npm-update",
      "name": "npm update",
      "kind": "command",
      "parent": "npm",
      "summary": "Atualiza os pacotes dentro das faixas permitidas no package.json",
      "aliases": ["npm up", "atualizar dependências npm"],
      "examples": [
        { "command": "npm update", "description": "Atualiza até o Wanted" },
        { "command": "npm i react@latest", "description": "Muda de versão major de propósito" }
      ],
      "related": ["npm-outdated", "semver"]
    },
    {
      "id": "npm-audit",
      "name": "npm audit",
      "kind": "command",
      "parent": "npm",
      "summary": "Procura vulnerabilidades conhecidas nas dependências",
      "aliases": ["vulnerabilidades npm", "npm audit fix", "segurança dependências"],
      "options": [
        { "long": "--omit", "arg": "TIPO", "description": "--omit=dev ignora dependências de desenvolvimento" },
        { "long": "--audit-level", "arg": "NÍVEL", "description": "Só falha a partir de: low, moderate, high, critical" },
        { "long": "--force", "description": "Com fix: aceita atualizações que quebram compatibilidade" }
      ],
      "arguments": [
        { "name": "fix", "kind": "text", "description": "fix aplica as correções compatíveis" }
      ],
      "examples": [
        { "command": "npm audit", "description": "Relatório" },
        { "command": "npm audit fix", "description": "Aplica as correções compatíveis" },
        { "command": "npm audit --omit=dev --audit-level=high", "description": "Para o CI" }
      ],
      "related": ["npm-update"],
      "warnings": ["npm audit fix --force pode subir versões major e quebrar o projeto: revise o diff do package.json."]
    },
    {
      "id": "npm-cache",
      "name": "npm cache",
      "kind": "command",
      "parent": "npm",
      "summary": "Gerencia o cache de pacotes baixados (~/.npm)",
      "examples": [
        { "command": "npm cache verify", "description": "Confere e limpa entradas corrompidas" },
        { "command": "npm cache clean --force", "description": "Apaga o cache" }
      ],
      "related": ["npm-clean-reinstall"]
    },
    {
      "id": "npm-config",
      "name": "npm config",
      "kind": "command",
      "parent": "npm",
      "summary": "Lê e define configurações: registry, proxy, certificados",
      "aliases": ["npmrc", ".npmrc", "registry npm", "proxy npm"],
      "examples": [
        { "command": "npm config list", "description": "Configuração efetiva" },
        { "command": "npm config get registry", "description": "De onde os pacotes vêm" },
        { "command": "npm config set registry https://npm.empresa.com/", "description": "Registry da empresa" },
        { "command": "npm config set cafile /etc/ssl/certs/ca-certificates.crt", "description": "Confia nas CAs do sistema (proxy corporativo)" }
      ],
      "related": ["error-corporate-cert"]
    },
    {
      "id": "npm-view",
      "name": "npm view",
      "kind": "command",
      "parent": "npm",
      "summary": "Informações de um pacote no registry: versões, dependências, datas",
      "aliases": ["npm info", "versões de um pacote", "npm show"],
      "examples": [
        { "command": "npm view express version", "description": "Última versão" },
        { "command": "npm view react versions --json", "description": "Todas as versões publicadas" }
      ],
      "related": ["npm-outdated"]
    },
    {
      "id": "npm-version",
      "name": "npm version",
      "kind": "command",
      "parent": "npm",
      "summary": "Mostra versões ou incrementa a versão do projeto (patch, minor, major)",
      "examples": [
        { "command": "npm version patch", "description": "1.2.3 → 1.2.4, com commit e tag" },
        { "command": "npm version", "description": "Versões do projeto, do Node e das dependências nativas" }
      ],
      "related": ["semver"]
    },
    {
      "name": "npx",
      "kind": "command",
      "wrapper": true,
      "summary": "Executa o binário de um pacote, baixando temporariamente se não estiver instalado",
      "usage": "npx [OPÇÕES] COMANDO [ARGS]",
      "aliases": ["npm exec", "executar pacote sem instalar"],
      "tags": ["node", "javascript"],
      "options": [
        { "short": "-y", "long": "--yes", "description": "Não pergunta antes de baixar" },
        { "short": "-p", "long": "--package", "arg": "PACOTE", "description": "Pacote que fornece o comando" }
      ],
      "examples": [
        { "command": "npx tsc --init", "description": "Usa o TypeScript do projeto" },
        { "command": "npx vite build", "description": "Binário instalado em node_modules/.bin" },
        { "command": "npx -y serve dist", "description": "Servidor estático sem instalar nada" }
      ],
      "related": ["npm", "npm-run"]
    },
    {
      "name": "nvm",
      "kind": "command",
      "builtin": true,
      "summary": "Instala e alterna versões do Node.js por usuário (Node Version Manager)",
      "description": "É uma função do shell carregada pelo ~/.bashrc, não um executável. Um arquivo .nvmrc no projeto fixa a versão.",
      "usage": "nvm install | use | ls | alias [VERSÃO]",
      "install": "Veja github.com/nvm-sh/nvm: o instalador é um script (curl ... | bash); leia antes de rodar.",
      "aliases": ["trocar versão do node", "versão do node", "node version manager", ".nvmrc"],
      "tags": ["node", "versões"],
      "examples": [
        { "command": "nvm install --lts", "description": "Instala a última LTS" },
        { "command": "nvm use 22", "description": "Usa o Node 22 neste terminal" },
        { "command": "nvm install", "description": "Instala a versão do .nvmrc" },
        { "command": "nvm ls", "description": "Versões instaladas" },
        { "command": "nvm alias default 22", "description": "Versão padrão dos novos terminais" }
      ],
      "related": ["node", "node-switch-version"]
    },
    {
      "id": "package-json",
      "name": "package.json",
      "kind": "concept",
      "summary": "Manifesto do projeto Node: nome, scripts, dependências e versões",
      "aliases": ["package json", "scripts npm", "dependencies", "devdependencies", "peerdependencies"],
      "tags": ["node", "configuração"],
      "examples": [
        { "command": "npm pkg get scripts", "description": "Os scripts do projeto" },
        { "command": "jq '.dependencies' package.json", "description": "As dependências" },
        { "command": "npm pkg set scripts.lint='eslint .'", "description": "Cria um script sem editar à mão" }
      ],
      "sections": [
        {
          "title": "Campos",
          "rows": [
            ["scripts", "comandos rodados com npm run NOME"],
            ["dependencies", "necessárias para rodar"],
            ["devDependencies", "só para desenvolver e testar (--omit=dev não instala)"],
            ["peerDependencies", "o projeto que usa este pacote deve fornecer (ex.: react)"],
            ["engines", "versões de Node aceitas"],
            ["type", "module usa import/export; commonjs, require"]
          ]
        }
      ],
      "related": ["npm", "semver", "lockfile"]
    },
    {
      "id": "lockfile",
      "name": "package-lock.json",
      "kind": "concept",
      "summary": "Registro das versões exatas instaladas: garante o mesmo node_modules em toda máquina",
      "description": "Deve ir para o repositório. npm install atualiza o lock quando o package.json muda; npm ci segue o lock à risca. yarn.lock e pnpm-lock.yaml são os equivalentes das outras ferramentas.",
      "aliases": ["package lock", "lock file", "yarn.lock", "pnpm-lock"],
      "tags": ["node", "dependências"],
      "examples": [
        { "command": "git diff package-lock.json | head", "description": "O que mudou nas versões" },
        { "command": "npm ci", "description": "Instala exatamente o lock" }
      ],
      "related": ["npm-ci", "package-json"]
    },
    {
      "id": "semver",
      "name": "Versões semânticas (^ e ~)",
      "kind": "concept",
      "summary": "MAJOR.MINOR.PATCH e as faixas de versão aceitas no package.json",
      "aliases": ["semver", "caret", "til", "^1.2.3", "~1.2.3", "faixa de versão"],
      "tags": ["node", "versões"],
      "examples": [
        { "command": "npm view react versions --json", "description": "Versões existentes" },
        { "command": "npx semver -r '^18.2.0' 18.3.1 19.0.0", "description": "Quais versões uma faixa aceita" }
      ],
      "sections": [
        {
          "title": "Faixas",
          "rows": [
            ["1.2.3", "exatamente esta"],
            ["^1.2.3", ">=1.2.3 e <2.0.0: aceita minor e patch"],
            ["~1.2.3", ">=1.2.3 e <1.3.0: só patch"],
            ["^0.2.3", ">=0.2.3 e <0.3.0: antes do 1.0, o minor quebra compatibilidade"],
            [">=1.2 <2", "faixa explícita"],
            ["*", "qualquer versão"]
          ]
        }
      ],
      "related": ["package-json", "npm-outdated"]
    },
    {
      "id": "npm-clean-reinstall",
      "name": "Limpar e reinstalar as dependências (npm)",
      "kind": "recipe",
      "summary": "Quando node_modules ficou inconsistente depois de trocar de branch ou de Node",
      "aliases": ["reinstalar node_modules", "apagar node_modules", "limpar npm", "node_modules corrompido"],
      "tags": ["node"],
      "steps": [
        { "title": "Apague node_modules", "command": "rm -rf node_modules", "why": "Mantenha o package-lock.json: ele garante as mesmas versões." },
        { "title": "Reinstale pelo lock", "command": "npm ci", "why": "Exato e reproduzível." },
        { "title": "Se ainda falhar", "command": "npm cache verify", "why": "Confere o cache." },
        { "title": "Último recurso", "command": "rm -rf node_modules package-lock.json && npm install", "why": "Regerar o lock muda versões: revise o diff antes de commitar." }
      ],
      "related": ["npm-ci", "lockfile", "npm-cache"]
    },
    {
      "id": "node-switch-version",
      "name": "Trocar a versão do Node",
      "kind": "recipe",
      "summary": "Usar a versão que o projeto pede",
      "aliases": ["trocar versão do node", "mudar versão do node", "node versão errada", "engine node incompatível"],
      "tags": ["node", "versões"],
      "steps": [
        { "title": "Qual o projeto pede", "command": "cat .nvmrc; npm pkg get engines", "why": "Veja o .nvmrc ou o campo engines do package.json." },
        { "title": "Instale e use", "command": "nvm install && nvm use", "why": "Lê o .nvmrc." },
        { "title": "Confira", "command": "node -v", "why": "Novos terminais voltam ao padrão (nvm alias default)." },
        { "title": "Reinstale as dependências", "command": "rm -rf node_modules && npm ci", "why": "Módulos nativos são compilados para uma versão do Node." }
      ],
      "related": ["nvm", "node"]
    }
  ]
}
