    {
      "name": "jq",
      "kind": "command",
      "summary": "Filtra, formata e transforma JSON na linha de comando",
      "description": "O filtro descreve um caminho no JSON: .campo, .lista[], .a.b. Filtros se encadeiam com | como no shell. Use aspas simples em volta do filtro.",
      "usage": "jq [OPÇÕES] FILTRO [ARQUIVO...]",
      "install": "Debian/Ubuntu: sudo apt install jq. Fedora: sudo dnf install jq.",
      "aliases": ["json", "formatar json", "pretty print json", "extrair campo json", "ler json", "parse json", "filtrar json"],
      "tags": ["json", "texto", "api"],
      "options": [
        { "short": "-r", "long": "--raw-output", "description": "Textos sem aspas (para usar em scripts)" },
        { "short": "-c", "long": "--compact-output", "description": "Um JSON por linha, sem formatação" },
        { "short": "-s", "long": "--slurp", "description": "Junta toda a entrada em um array" },
        { "short": "-e", "long": "--exit-status", "description": "Exit code 1 se o resultado for false ou null" },
        { "short": "-S", "long": "--sort-keys", "description": "Ordena as chaves" },
        { "short": "-n", "long": "--null-input", "description": "Não lê entrada (para construir JSON)" },
        { "long": "--arg", "arg": "NOME VALOR", "description": "Passa uma variável de texto ($NOME no filtro)" }
      ],
      "arguments": [
        { "name": "FILTRO", "kind": "text", "description": "Expressão jq, ex.: '.items[].name'" },
        { "name": "ARQUIVO", "kind": "path", "description": "Arquivos JSON (sem arquivo: stdin)", "repeat": true }
      ],
      "examples": [
        { "command": "jq . dados.json", "description": "Formata e colore" },
        { "command": "curl -s https://api.github.com/repos/jqlang/jq | jq '.stargazers_count'", "description": "Um campo da resposta de uma API" },
        { "command": "jq -r '.[].name' usuarios.json", "description": "O campo de cada item de uma lista, sem aspas" },
