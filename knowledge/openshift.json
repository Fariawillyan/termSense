{
  "category": "openshift",
  "entries": [
    {
      "name": "oc",
      "kind": "command",
      "summary": "CLI do OpenShift: projetos, pods, deploys e rotas (aceita os comandos do kubectl)",
      "description": "O oc inclui todos os comandos do kubectl e acrescenta os do OpenShift (login, project, rsh, new-app, start-build). Recursos são escritos como tipo (pods) ou tipo/nome (deployment/api).",
      "usage": "oc SUBCOMANDO [RECURSO] [NOME] [OPÇÕES]",
      "install": "Baixe pelo console do cluster (? → Command line tools) ou em mirror.openshift.com: é um binário só; ponha no PATH.",
      "aliases": ["openshift", "ocp", "openshift cli", "kubernetes", "k8s", "kubectl"],
      "tags": ["openshift", "kubernetes"],
      "options": [
        { "short": "-n", "long": "--namespace", "arg": "PROJETO", "description": "Projeto (namespace) do comando, em vez do atual" },
        { "short": "-o", "long": "--output", "arg": "FORMATO", "description": "wide, yaml, json, name, jsonpath={...}, custom-columns=..." },
        { "short": "-l", "long": "--selector", "arg": "RÓTULOS", "description": "Filtra por labels: -l app=api,tier=web" },
        { "short": "-A", "long": "--all-namespaces", "description": "Todos os projetos" },
        { "short": "-w", "long": "--watch", "description": "Continua mostrando as mudanças" },
        { "long": "--context", "arg": "CONTEXTO", "description": "Outro cluster ou usuário do kubeconfig" }
      ],
      "examples": [
        { "command": "oc whoami --show-server", "description": "Em qual cluster você está" },
        { "command": "oc project", "description": "Projeto atual" },
        { "command": "oc get pods", "description": "Pods do projeto" },
        { "command": "oc logs -f deployment/api", "description": "Logs da aplicação" },
        { "command": "oc rsh deployment/api", "description": "Shell dentro de um pod" },
        { "command": "oc get events --sort-by=.lastTimestamp", "description": "O que aconteceu por último" }
      ],
      "related": ["oc-get", "oc-logs", "ocp-pod-troubleshooting", "pod-states"],
      "names": ["kubectl", "openshift"]
    },
    {
      "id": "oc-login",
      "name": "oc login",
      "kind": "command",
      "parent": "oc",
      "summary": "Entra no cluster (com token ou usuário e senha)",
      "description": "O jeito mais fácil: no console web, menu do usuário → Copy login command, e cole o comando pronto.",
      "aliases": ["logar no openshift", "login ocp", "copy login command", "token openshift"],
      "options": [
        { "long": "--token", "arg": "TOKEN", "description": "Token de acesso (sha256~...)" },
        { "short": "-s", "long": "--server", "arg": "URL", "description": "API do cluster (https://api.cluster:6443)" },
        { "short": "-u", "long": "--username", "arg": "USUÁRIO", "description": "Login com usuário e senha" },
        { "long": "--certificate-authority", "arg": "ARQUIVO", "description": "CA do cluster, quando não é confiável pelo sistema" },
        { "long": "--insecure-skip-tls-verify", "description": "Não verifica o certificado (evite)" }
      ],
      "examples": [
        { "command": "oc login --token=sha256~xxxx --server=https://api.cluster.exemplo.com:6443", "description": "Comando copiado do console" },
        { "command": "oc login -u desenvolvedor https://api.cluster.exemplo.com:6443", "description": "Com usuário e senha" }
      ],
      "related": ["oc-whoami", "oc-project", "error-oc-unauthorized"],
      "warnings": ["--insecure-skip-tls-verify desliga a verificação do certificado: prefira --certificate-authority com a CA do cluster."]
    },
    {
      "id": "oc-whoami",
      "name": "oc whoami",
      "kind": "command",
      "parent": "oc",
      "summary": "Mostra o usuário logado (e o servidor, o console ou o token)",
      "options": [
        { "long": "--show-server", "description": "URL da API do cluster" },
        { "long": "--show-console", "description": "URL do console web" },
        { "short": "-t", "long": "--show-token", "description": "O token atual (é um segredo)" }
      ],
      "examples": [
        { "command": "oc whoami", "description": "Seu usuário" },
        { "command": "oc whoami --show-console", "description": "Endereço do console" }
      ],
      "related": ["oc-login"]
    },
    {
      "id": "oc-project",
      "name": "oc project",
      "kind": "command",
      "parent": "oc",
      "summary": "Mostra ou troca o projeto (namespace) atual",
      "aliases": ["trocar de projeto", "mudar namespace", "namespace atual"],
      "arguments": [
        { "name": "PROJETO", "kind": "text", "description": "Projeto para onde ir" }
      ],
      "examples": [
        { "command": "oc project", "description": "Projeto atual" },
        { "command": "oc project minha-app", "description": "Troca de projeto" },
        { "command": "oc projects", "description": "Projetos a que você tem acesso" }
      ],
      "related": ["oc-projects", "project-kind"]
    },
    {
      "id": "oc-projects",
      "name": "oc projects",
      "kind": "command",
      "parent": "oc",
      "summary": "Lista os projetos a que você tem acesso",
      "examples": [
        { "command": "oc projects", "description": "Todos os seus projetos" }
      ],
      "related": ["oc-project"]
    },
    {
      "id": "oc-get",
      "name": "oc get",
      "kind": "command",
      "parent": "oc",
      "summary": "Lista recursos: pods, deployments, services, rotas e outros",
      "aliases": ["listar pods", "ver pods", "kubectl get"],
      "options": [
        { "long": "--show-labels", "description": "Mostra os labels" },
        { "long": "--sort-by", "arg": "CAMPO", "description": "Ordena por um campo: .lastTimestamp, .status.startTime" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" },
        { "name": "NOME", "kind": "text", "description": "Nome do recurso (quando o tipo veio separado)" }
      ],
      "examples": [
        { "command": "oc get pods", "description": "Pods e seus estados" },
        { "command": "oc get pods -o wide", "description": "Com nó e IP" },
        { "command": "oc get all", "description": "Pods, deployments, services, rotas..." },
        { "command": "oc get deploy,svc,route", "description": "Vários tipos de uma vez" },
        { "command": "oc get pod api-7d9f-x2k -o yaml", "description": "Definição completa de um pod" },
        { "command": "oc get pods -l app=api -w", "description": "Acompanha os pods de uma aplicação" },
        { "command": "oc get events --sort-by=.lastTimestamp", "description": "Eventos recentes do projeto" },
        { "command": "oc get secret db -o jsonpath='{.data.password}' | base64 -d", "description": "Lê um valor de um secret" }
      ],
      "related": ["oc-describe", "pod-states"]
    },
    {
      "id": "oc-describe",
      "name": "oc describe",
      "kind": "command",
      "parent": "oc",
      "summary": "Detalhes e eventos de um recurso: o primeiro lugar para ver por que um pod não sobe",
      "aliases": ["detalhes do pod", "eventos do pod", "kubectl describe"],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" },
        { "name": "NOME", "kind": "text", "description": "Nome do recurso (quando o tipo veio separado)" }
      ],
      "examples": [
        { "command": "oc describe pod api-7d9f-x2k", "description": "Estado, eventos e último motivo de saída" },
        { "command": "oc describe deployment/api", "description": "Réplicas, imagem e condições" }
      ],
      "related": ["oc-get", "ocp-pod-troubleshooting"]
    },
    {
      "id": "oc-logs",
      "name": "oc logs",
      "kind": "command",
      "parent": "oc",
      "summary": "Mostra os logs de um pod, deployment ou build",
      "aliases": ["logs do pod", "logs openshift", "kubectl logs"],
      "options": [
        { "short": "-f", "long": "--follow", "description": "Acompanha" },
        { "short": "-p", "long": "--previous", "description": "Logs da execução anterior (depois de um restart ou CrashLoopBackOff)" },
        { "short": "-c", "long": "--container", "arg": "NOME", "description": "Container do pod (quando há mais de um)" },
        { "long": "--tail", "arg": "N", "description": "Só as últimas N linhas" },
        { "long": "--since", "arg": "DURAÇÃO", "description": "Só os recentes: 10m, 1h" },
        { "long": "--all-containers", "description": "De todos os containers do pod" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc logs -f deployment/api", "description": "Acompanha um pod da aplicação" },
        { "command": "oc logs api-7d9f-x2k -p", "description": "Por que o container anterior morreu" },
        { "command": "oc logs api-7d9f-x2k -c sidecar --tail 100", "description": "Um container específico" },
        { "command": "oc logs --since=10m -l app=api", "description": "Últimos 10 minutos de todos os pods da aplicação" }
      ],
      "related": ["oc-get", "error-crashloopbackoff"]
    },
    {
      "id": "oc-rsh",
      "name": "oc rsh",
      "kind": "command",
      "parent": "oc",
      "summary": "Abre um shell dentro de um pod",
      "aliases": ["entrar no pod", "shell no pod", "acessar pod"],
      "options": [
        { "short": "-c", "long": "--container", "arg": "NOME", "description": "Container do pod" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc rsh api-7d9f-x2k", "description": "Shell no pod" },
        { "command": "oc rsh deployment/api", "description": "Em um pod da aplicação" }
      ],
      "related": ["oc-exec", "oc-debug"]
    },
    {
      "id": "oc-exec",
      "name": "oc exec",
      "kind": "command",
      "parent": "oc",
      "summary": "Executa um comando dentro de um pod",
      "aliases": ["kubectl exec", "comando no pod"],
      "options": [
        { "short": "-i", "long": "--stdin", "description": "Mantém a entrada aberta" },
        { "short": "-t", "long": "--tty", "description": "Aloca um terminal" },
        { "short": "-c", "long": "--container", "arg": "NOME", "description": "Container do pod" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc exec api-7d9f-x2k -- env", "description": "Variáveis de ambiente do container" },
        { "command": "oc exec -it api-7d9f-x2k -- bash", "description": "Shell interativo" }
      ],
      "related": ["oc-rsh"]
    },
    {
      "id": "oc-cp",
      "name": "oc cp",
      "kind": "command",
      "parent": "oc",
      "summary": "Copia arquivos entre a máquina e um pod",
      "aliases": ["copiar arquivo do pod", "copiar para o pod"],
      "examples": [
        { "command": "oc cp api-7d9f-x2k:/tmp/heap.hprof ./heap.hprof", "description": "Do pod para a máquina" },
        { "command": "oc cp config.yml api-7d9f-x2k:/tmp/", "description": "Da máquina para o pod" }
      ],
      "related": ["oc-rsh"]
    },
    {
      "id": "oc-port-forward",
      "name": "oc port-forward",
      "kind": "command",
      "parent": "oc",
      "summary": "Encaminha uma porta local para um pod ou serviço do cluster",
      "aliases": ["acessar serviço do cluster", "port forward", "túnel para o pod"],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" },
        { "name": "PORTAS", "kind": "text", "description": "LOCAL:REMOTA, ou uma porta só" }
      ],
      "examples": [
        { "command": "oc port-forward svc/postgres 5432:5432", "description": "Banco do cluster em localhost:5432" },
        { "command": "oc port-forward deployment/api 8080", "description": "API em localhost:8080" }
      ],
      "related": ["ocp-access-local"]
    },
    {
      "id": "oc-apply",
      "name": "oc apply",
      "kind": "command",
      "parent": "oc",
      "summary": "Cria ou atualiza recursos a partir de arquivos YAML",
      "aliases": ["kubectl apply", "aplicar yaml"],
      "options": [
        { "short": "-f", "long": "--filename", "arg": "ARQUIVO", "description": "Arquivo, pasta ou URL" },
        { "short": "-k", "long": "--kustomize", "arg": "DIR", "description": "Pasta com kustomization.yaml" },
        { "long": "--dry-run", "arg": "MODO", "description": "server valida no cluster sem aplicar; client só localmente" }
      ],
      "examples": [
        { "command": "oc apply -f deployment.yaml", "description": "Aplica um arquivo" },
        { "command": "oc apply -f k8s/", "description": "Toda a pasta" },
        { "command": "oc apply -f app.yaml --dry-run=server", "description": "Valida sem aplicar" }
      ],
      "related": ["oc-delete", "oc-get"]
    },
    {
      "id": "oc-delete",
      "name": "oc delete",
      "kind": "command",
      "parent": "oc",
      "summary": "Apaga recursos",
      "aliases": ["kubectl delete", "apagar pod"],
      "options": [
        { "short": "-f", "long": "--filename", "arg": "ARQUIVO", "description": "Apaga o que está no arquivo" },
        { "long": "--grace-period", "arg": "SEGUNDOS", "description": "Tempo para o encerramento limpo" },
        { "long": "--force", "description": "Remove sem esperar o encerramento (último recurso)" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" },
        { "name": "NOME", "kind": "text", "description": "Nome do recurso (quando o tipo veio separado)" }
      ],
      "examples": [
        { "command": "oc delete pod api-7d9f-x2k", "description": "O deployment cria outro: reinício rápido de um pod" },
        { "command": "oc delete -f app.yaml", "description": "Apaga o que o arquivo criou" }
      ],
      "related": ["oc-apply", "oc-rollout-restart"],
      "warnings": ["Não há lixeira. oc delete project apaga tudo que há dentro do projeto."]
    },
    {
      "id": "oc-scale",
      "name": "oc scale",
      "kind": "command",
      "parent": "oc",
      "summary": "Muda o número de réplicas de um deployment",
      "aliases": ["escalar", "aumentar réplicas", "desligar aplicação"],
      "options": [
        { "long": "--replicas", "arg": "N", "description": "Quantidade de pods" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc scale deployment/api --replicas=3", "description": "Três pods" },
        { "command": "oc scale deployment/api --replicas=0", "description": "Desliga sem apagar" }
      ],
      "related": ["oc-rollout", "deployment-kind"]
    },
    {
      "id": "oc-rollout",
      "name": "oc rollout",
      "kind": "command",
      "parent": "oc",
      "summary": "Acompanha e controla implantações: status, restart, undo e histórico",
      "aliases": ["kubectl rollout", "implantação"],
      "examples": [
        { "command": "oc rollout status deployment/api", "description": "Espera terminar" },
        { "command": "oc rollout restart deployment/api", "description": "Recria os pods" }
      ],
      "related": ["ocp-restart-app", "ocp-rollback"]
    },
    {
      "id": "oc-rollout-status",
      "name": "oc rollout status",
      "kind": "command",
      "parent": "oc-rollout",
      "summary": "Espera e mostra o andamento de uma implantação",
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc rollout status deployment/api", "description": "Termina quando todos os pods novos estão prontos" }
      ],
      "related": ["oc-rollout-restart"]
    },
    {
      "id": "oc-rollout-restart",
      "name": "oc rollout restart",
      "kind": "command",
      "parent": "oc-rollout",
      "summary": "Recria os pods de um deployment, um de cada vez",
      "aliases": ["reiniciar deployment", "reiniciar aplicação", "restart pods"],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc rollout restart deployment/api", "description": "Aplica um ConfigMap ou Secret alterado" }
      ],
      "related": ["oc-rollout-status", "ocp-restart-app"]
    },
    {
      "id": "oc-rollout-undo",
      "name": "oc rollout undo",
      "kind": "command",
      "parent": "oc-rollout",
      "summary": "Volta para a versão anterior de um deployment",
      "aliases": ["rollback", "voltar versão", "desfazer deploy"],
      "options": [
        { "long": "--to-revision", "arg": "N", "description": "Uma revisão específica (veja em history)" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc rollout undo deployment/api", "description": "Revisão anterior" },
        { "command": "oc rollout undo deployment/api --to-revision=3", "description": "Revisão 3" }
      ],
      "related": ["oc-rollout-history", "ocp-rollback"]
    },
    {
      "id": "oc-rollout-history",
      "name": "oc rollout history",
      "kind": "command",
      "parent": "oc-rollout",
      "summary": "Lista as revisões de um deployment",
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc rollout history deployment/api", "description": "Revisões" },
        { "command": "oc rollout history deployment/api --revision=3", "description": "O que tinha na revisão 3" }
      ],
      "related": ["oc-rollout-undo"]
    },
    {
      "id": "oc-set",
      "name": "oc set",
      "kind": "command",
      "parent": "oc",
      "summary": "Altera partes de um recurso: variáveis, imagem, recursos",
      "examples": [
        { "command": "oc set env deployment/api LOG_LEVEL=debug", "description": "Define uma variável" }
      ],
      "related": ["oc-set-env", "oc-set-image", "oc-set-resources"]
    },
    {
      "id": "oc-set-env",
      "name": "oc set env",
      "kind": "command",
      "parent": "oc-set",
      "summary": "Define, remove ou lista variáveis de ambiente",
      "aliases": ["variável de ambiente openshift", "mudar env do deployment"],
      "options": [
        { "long": "--list", "description": "Lista as variáveis" },
        { "long": "--from", "arg": "FONTE", "description": "Importa de secret/NOME ou configmap/NOME" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" },
        { "name": "VARIÁVEIS", "kind": "text", "description": "NOME=valor; NOME- remove", "repeat": true }
      ],
      "examples": [
        { "command": "oc set env deployment/api LOG_LEVEL=debug", "description": "Define (recria os pods)" },
        { "command": "oc set env deployment/api --list", "description": "Lista" },
        { "command": "oc set env deployment/api --from=secret/db", "description": "Variáveis a partir de um secret" },
        { "command": "oc set env deployment/api LOG_LEVEL-", "description": "Remove" }
      ],
      "related": ["configmap-kind", "secret-kind"]
    },
    {
      "id": "oc-set-image",
      "name": "oc set image",
      "kind": "command",
      "parent": "oc-set",
      "summary": "Troca a imagem de um container",
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" },
        { "name": "CONTAINER=IMAGEM", "kind": "text", "description": "Container e nova imagem" }
      ],
      "examples": [
        { "command": "oc set image deployment/api api=registry.exemplo.com/api:1.4.2", "description": "Nova versão" }
      ],
      "related": ["oc-rollout-status"]
    },
    {
      "id": "oc-set-resources",
      "name": "oc set resources",
      "kind": "command",
      "parent": "oc-set",
      "summary": "Define requests e limits de CPU e memória",
      "aliases": ["limite de memória", "limits", "requests"],
      "options": [
        { "long": "--limits", "arg": "RECURSOS", "description": "Máximo: cpu=500m,memory=512Mi" },
        { "long": "--requests", "arg": "RECURSOS", "description": "Reservado para agendar o pod" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc set resources deployment/api --limits=memory=1Gi,cpu=1 --requests=memory=512Mi,cpu=200m", "description": "Limites e reservas" }
      ],
      "related": ["resource-units", "error-oomkilled"]
    },
    {
      "id": "oc-expose",
      "name": "oc expose",
      "kind": "command",
      "parent": "oc",
      "summary": "Cria um service para um deployment, ou uma rota para um service",
      "aliases": ["criar rota", "expor serviço", "url externa"],
      "options": [
        { "long": "--port", "arg": "PORTA", "description": "Porta do service" }
      ],
      "arguments": [
        { "name": "RECURSO", "kind": "resource", "description": "Tipo (pods, deploy, svc...) ou tipo/nome (deployment/api)" }
      ],
      "examples": [
        { "command": "oc expose svc/api", "description": "Cria uma rota (URL externa)" },
        { "command": "oc expose deployment/api --port=8080", "description": "Cria um service" }
      ],
      "related": ["route-kind", "service-kind"]
    },
    {
      "id": "oc-create",
      "name": "oc create",
      "kind": "command",
      "parent": "oc",
      "summary": "Cria recursos: secrets, configmaps, rotas, a partir de valores ou arquivos",
      "examples": [
        { "command": "oc create secret generic db --from-literal=password=segredo", "description": "Secret com um valor" },
        { "command": "oc create configmap app-config --from-file=application.yml", "description": "ConfigMap a partir de um arquivo" },
        { "command": "oc create route edge api --service=api", "description": "Rota HTTPS com TLS no roteador" },
        { "command": "oc create secret docker-registry registro --docker-server=registry.exemplo.com --docker-username=USUARIO --docker-password=SENHA", "description": "Credencial para baixar imagens" }
      ],
      "related": ["secret-kind", "configmap-kind", "route-kind"]
    },
    {
      "id": "oc-new-app",
      "name": "oc new-app",
      "kind": "command",
      "parent": "oc",
