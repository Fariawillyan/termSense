    {
      "id": "docker-container-ip",
      "name": "Descobrir o IP de um container",
      "kind": "recipe",
      "summary": "Endereço de um container nas redes Docker",
      "aliases": ["ip do container", "endereço do container", "container ip"],
      "tags": ["docker", "rede"],
      "examples": [
        { "command": "docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' container", "description": "IP em cada rede" },
        { "command": "docker network inspect bridge", "description": "IPs de todos os containers da rede" }
      ],
      "related": ["docker-inspect", "docker-network"]
    },
    {
      "id": "docker-cleanup",
      "name": "Liberar espaço do Docker",
      "kind": "recipe",
      "summary": "Remover containers parados, imagens e caches sem uso",
      "aliases": ["limpar docker", "docker ocupando espaço", "docker prune", "liberar espaço docker"],
      "tags": ["docker", "disco"],
      "examples": [
        { "command": "docker system df", "description": "Quanto espaço cada tipo ocupa" },
        { "command": "docker container prune", "description": "Remove containers parados" },
        { "command": "docker image prune -a", "description": "Remove imagens sem container associado" },
        { "command": "docker system prune", "description": "Containers parados, redes e imagens órfãs" }
