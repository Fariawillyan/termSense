      "name": "Ver logs de um container",
      "kind": "recipe",
      "summary": "Ler e acompanhar a saída de um container",
      "aliases": ["logs container", "logs do container", "ver logs do container", "container logs"],
      "tags": ["docker", "logs"],
      "examples": [
        { "command": "docker logs container", "description": "Toda a saída" },
        { "command": "docker logs -f container", "description": "Em tempo real" },
