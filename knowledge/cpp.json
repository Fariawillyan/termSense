{
  "category": "cpp",
  "entries": [
    {
      "id": "gpp",
      "name": "g++",
      "kind": "command",
      "summary": "Compilador C++ do GCC (gcc compila C, com as mesmas opções)",
      "description": "Compila e liga em um passo só, ou em etapas (-c gera objetos, depois o g++ liga). Bibliotecas (-l) vêm depois dos arquivos que as usam.",
      "usage": "g++ [OPÇÕES] ARQUIVOS... [-o SAÍDA]",
      "install": "Debian/Ubuntu: sudo apt install build-essential (gcc, g++, make e cabeçalhos da libc).",
      "aliases": ["gcc", "compilar c++", "compilar c", "compilador c++", "compile cpp"],
      "tags": ["c++", "compilação"],
      "options": [
        { "short": "-o", "arg": "ARQUIVO", "description": "Nome do arquivo gerado (padrão: a.out)" },
        { "short": "-c", "description": "Só compila para objeto (.o), sem ligar" },
        { "short": "-std", "arg": "PADRÃO", "description": "Versão da linguagem: -std=c++17, -std=c++20, -std=c11" },
        { "short": "-Wall", "description": "Liga os avisos mais importantes" },
        { "short": "-Wextra", "description": "Avisos adicionais" },
        { "short": "-Werror", "description": "Trata avisos como erros" },
        { "short": "-Wpedantic", "description": "Avisa sobre extensões fora do padrão" },
        { "short": "-W", "arg": "AVISO", "prefix": true, "description": "Liga um aviso específico: -Wshadow, -Wconversion" },
        { "short": "-Wl,", "arg": "OPÇÕES", "prefix": true, "description": "Repassa opções ao linker, separadas por vírgula: -Wl,-rpath,/opt/lib" },
        { "short": "-O", "arg": "NÍVEL", "description": "Otimização: -O0 (nenhuma, padrão), -O2 (produção), -O3, -Os (tamanho), -Og (depuração)" },
        { "short": "-g", "description": "Inclui símbolos de depuração (para gdb e sanitizers)" },
        { "short": "-I", "arg": "DIR", "description": "Pasta extra de cabeçalhos para #include (-Iinclude)" },
        { "short": "-L", "arg": "DIR", "description": "Pasta extra de bibliotecas" },
        { "short": "-l", "arg": "BIBLIOTECA", "description": "Liga uma biblioteca: -lpthread liga libpthread; vem depois dos arquivos" },
        { "short": "-D", "arg": "MACRO", "description": "Define uma macro: -DDEBUG, -DVERSAO=2" },
        { "short": "-fsanitize", "arg": "VERIFICADORES", "description": "Sanitizers: -fsanitize=address,undefined acha acesso inválido à memória e comportamento indefinido" },
        { "short": "-f", "arg": "OPÇÃO", "prefix": true, "description": "Opção de geração de código: -fPIC, -fno-exceptions" },
        { "short": "-march", "arg": "CPU", "description": "Gera código para uma CPU: -march=native usa tudo o que esta máquina tem" },
        { "short": "-m", "arg": "OPÇÃO", "prefix": true, "description": "Opção de arquitetura: -m64, -mavx2" },
        { "short": "-pthread", "description": "Suporte a threads (compilar e ligar)" },
        { "short": "-shared", "description": "Gera uma biblioteca dinâmica (.so); use com -fPIC" },
        { "short": "-E", "description": "Só roda o pré-processador" },
        { "short": "-S", "description": "Gera assembly (.s)" },
        { "short": "-v", "description": "Mostra os passos e as pastas de busca" }
      ],
      "arguments": [
        { "name": "ARQUIVOS", "kind": "path", "description": "Fontes (.cpp, .c), objetos (.o) e bibliotecas (.a)", "repeat": true }
      ],
      "examples": [
        { "command": "g++ -std=c++17 -Wall -Wextra -g -o app main.cpp", "description": "Compilação de desenvolvimento" },
        { "command": "g++ -std=c++20 -O2 -o app *.cpp", "description": "Otimizado, vários arquivos" },
        { "command": "gcc -Wall -o prog prog.c", "description": "Programa em C" },
        { "command": "g++ -c util.cpp -o util.o", "description": "Só o objeto" },
        { "command": "g++ main.o util.o -o app -lpthread", "description": "Liga objetos e bibliotecas" },
        { "command": "g++ -g -fsanitize=address,undefined -o app main.cpp", "description": "Acha acessos inválidos à memória ao rodar" },
        { "command": "g++ -Iinclude -Llib -o app src/main.cpp -lminhalib", "description": "Cabeçalhos e bibliotecas em pastas próprias" },
        { "command": "g++ -std=c++17 -E main.cpp | less", "description": "Vê o código depois do pré-processador" }
      ],
      "related": ["clangpp", "make", "cmake", "compile-link", "error-undefined-reference"],
      "names": ["gcc", "c++"]
    },
