    {
      "id": "compile-link",
      "name": "Compilação e linkagem",
      "kind": "concept",
      "summary": "As etapas que transformam fontes C/C++ em executável, e o erro típico de cada uma",
      "aliases": ["compilação c++", "linker", "linkagem", "linkedição", "objeto .o"],
      "tags": ["c++", "compilação"],
      "examples": [
        { "command": "g++ -c a.cpp -o a.o && g++ -c b.cpp -o b.o && g++ a.o b.o -o app", "description": "As etapas separadas" },
        { "command": "nm -C app.o | grep ' U '", "description": "Símbolos que o objeto usa, mas não define" }
      ],
      "sections": [
        {
          "title": "Etapas",
          "rows": [
