        { "long": "--show-leak-kinds", "arg": "TIPOS", "description": "all inclui os ainda alcançáveis" }
      ],
      "examples": [
        { "command": "valgrind --leak-check=full ./app", "description": "Vazamentos com a pilha de onde a memória foi alocada" },
        { "command": "valgrind --track-origins=yes ./app", "description": "Uso de variáveis não inicializadas" }
      ],
      "related": ["gdb", "gpp", "cpp-debug-crash"]
