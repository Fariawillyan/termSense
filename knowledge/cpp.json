    {
      "name": "make",
      "kind": "command",
      "summary": "Executa as regras de um Makefile, recompilando só o que mudou",
      "usage": "make [OPÇÕES] [ALVO...] [VAR=VALOR]",
      "install": "Debian/Ubuntu: sudo apt install make (vem no build-essential).",
      "aliases": ["makefile", "compilar com make", "make build"],
      "tags": ["c++", "build"],
      "options": [
        { "short": "-j", "long": "--jobs", "arg": "N", "description": "Tarefas em paralelo: -j$(nproc) usa todos os núcleos" },
        { "short": "-C", "long": "--directory", "arg": "DIR", "description": "Roda em outra pasta (como cd DIR && make)" },
        { "short": "-f", "long": "--file", "arg": "ARQUIVO", "description": "Usa outro Makefile" },
        { "short": "-n", "long": "--dry-run", "description": "Mostra os comandos sem executar" },
        { "short": "-B", "long": "--always-make", "description": "Refaz tudo, mesmo o que está em dia" },
        { "short": "-k", "long": "--keep-going", "description": "Continua depois de um erro" }
      ],
      "arguments": [
        { "name": "ALVO", "kind": "text", "description": "Regras do Makefile: all (padrão), clean, install, test...", "repeat": true }
      ],
      "examples": [
        { "command": "make", "description": "Constrói o alvo padrão" },
        { "command": "make -j$(nproc)", "description": "Em paralelo, um processo por núcleo" },
        { "command": "make clean", "description": "Apaga os resultados" },
        { "command": "make -C build", "description": "Constrói na pasta build/ (ex.: gerada pelo CMake)" },
        { "command": "make VERBOSE=1", "description": "Mostra os comandos completos (Makefiles do CMake)" },
        { "command": "make -n install", "description": "O que o install faria" }
      ],
      "related": ["cmake", "gpp"]
    },
    {
      "name": "cmake",
      "kind": "command",
      "summary": "Configura e gera o build de projetos C/C++ a partir do CMakeLists.txt",
      "description": "Dois passos: configurar (cmake -S . -B build gera os arquivos de build) e compilar (cmake --build build). A pasta de build fica separada do código; apagá-la é o jeito de reconfigurar do zero.",
      "usage": "cmake -S FONTE -B BUILD [-D VAR=VALOR] | cmake --build BUILD [--target ALVO]",
      "install": "Debian/Ubuntu: sudo apt install cmake (e ninja-build para usar -G Ninja).",
      "aliases": ["cmakelists", "cmakelists.txt", "configurar projeto c++", "cmake build"],
      "tags": ["c++", "build"],
      "options": [
        { "short": "-S", "arg": "DIR", "description": "Pasta do código (onde está o CMakeLists.txt)" },
        { "short": "-B", "arg": "DIR", "description": "Pasta do build (criada se não existir)" },
        { "short": "-G", "arg": "GERADOR", "description": "Ninja, \"Unix Makefiles\"..." },
        { "short": "-D", "arg": "VAR=VALOR", "description": "Variável de cache: -DCMAKE_BUILD_TYPE=Release, -DCMAKE_PREFIX_PATH=/opt/lib" },
        { "long": "--build", "arg": "DIR", "description": "Compila uma pasta de build já configurada" },
        { "long": "--target", "arg": "ALVO", "description": "Com --build: só este alvo" },
        { "short": "-j", "long": "--parallel", "arg": "N", "description": "Com --build: tarefas em paralelo" },
        { "long": "--config", "arg": "CONFIG", "description": "Com --build em geradores multi-config: Debug, Release" },
        { "long": "--install", "arg": "DIR", "description": "Instala o que foi construído" },
        { "long": "--prefix", "arg": "DIR", "description": "Com --install: onde instalar" },
        { "long": "--preset", "arg": "NOME", "description": "Usa um preset do CMakePresets.json" },
        { "long": "--list-presets", "description": "Lista os presets" },
        { "long": "--fresh", "description": "Reconfigura do zero, ignorando o cache (CMake 3.24+)" }
      ],
      "examples": [
        { "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug", "description": "Configura em build/" },
        { "command": "cmake --build build -j", "description": "Compila em paralelo" },
        { "command": "cmake --build build --target testes", "description": "Só um alvo" },
        { "command": "cmake -S . -B build -G Ninja", "description": "Usa o Ninja (mais rápido que make)" },
        { "command": "cmake --install build --prefix ~/.local", "description": "Instala para o seu usuário" },
        { "command": "cmake --preset debug", "description": "Configura por preset" },
        { "command": "cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "description": "Gera compile_commands.json para a IDE e o clang-tidy" }
      ],
      "related": ["ctest", "make", "cpp-build-cmake", "error-cmake-package"]
    },
    {
      "name": "ctest",
      "kind": "command",
      "summary": "Roda os testes registrados no CMake (add_test, gtest_discover_tests)",
      "usage": "ctest --test-dir BUILD [OPÇÕES]",
      "aliases": ["rodar testes cmake", "testes c++", "cmake test"],
      "tags": ["c++", "testes"],
      "options": [
        { "long": "--test-dir", "arg": "DIR", "description": "Pasta de build (ou rode dentro dela)" },
        { "short": "-R", "long": "--tests-regex", "arg": "REGEX", "kind": "regex", "description": "Só os testes cujo nome casa com a regex" },
        { "short": "-E", "long": "--exclude-regex", "arg": "REGEX", "kind": "regex", "description": "Exclui os testes que casam" },
        { "long": "--output-on-failure", "description": "Mostra a saída dos testes que falharam" },
        { "short": "-j", "long": "--parallel", "arg": "N", "description": "Testes em paralelo" },
        { "long": "--rerun-failed", "description": "Só os que falharam na última execução" },
        { "long": "--repeat", "arg": "MODO:N", "description": "Repete: until-fail:20 acha testes instáveis" },
        { "short": "-N", "long": "--show-only", "description": "Lista os testes sem rodar" },
        { "short": "-V", "long": "--verbose", "description": "Saída completa" },
        { "short": "-L", "long": "--label-regex", "arg": "REGEX", "description": "Só testes com o label" }
      ],
      "examples": [
        { "command": "ctest --test-dir build --output-on-failure", "description": "Todos, mostrando as falhas" },
        { "command": "ctest --test-dir build -R Pedido", "description": "Só os que têm Pedido no nome" },
        { "command": "ctest --test-dir build --rerun-failed --output-on-failure", "description": "De novo só os que falharam" },
        { "command": "ctest --test-dir build -j 8", "description": "Em paralelo" },
        { "command": "ctest --test-dir build -N", "description": "Lista os testes" },
        { "command": "ctest --test-dir build --repeat until-fail:50 -R Flaky", "description": "Caça um teste instável" }
      ],
      "related": ["cmake", "gtest", "gtest-run-one"]
    },
    {
      "id": "gtest",
      "name": "GoogleTest",
      "kind": "concept",
      "summary": "Framework de testes unitários C++: o binário de testes aceita as flags --gtest_*",
      "description": "Os testes viram um executável do seu projeto (ex.: build/testes). Todas as flags também funcionam como variáveis de ambiente: --gtest_filter=X equivale a GTEST_FILTER=X.",
      "aliases": ["googletest", "gtest", "google test", "gtest filter", "testes unitários c++", "unit test c++", "gmock"],
      "tags": ["c++", "testes"],
      "options": [
        { "long": "--gtest_filter", "arg": "PADRÃO", "description": "Só os testes que casam: Suite.Teste, Suite.*, *Pedido*; depois de - vêm os excluídos (Suite.*-Suite.Lento)" },
        { "long": "--gtest_list_tests", "description": "Lista os testes sem rodar" },
        { "long": "--gtest_repeat", "arg": "N", "description": "Repete N vezes (-1 = para sempre): acha testes instáveis" },
        { "long": "--gtest_shuffle", "description": "Embaralha a ordem: revela testes que dependem de outros" },
        { "long": "--gtest_random_seed", "arg": "N", "description": "Semente do embaralhamento, para reproduzir" },
        { "long": "--gtest_break_on_failure", "description": "Para no depurador na primeira falha" },
        { "long": "--gtest_fail_fast", "description": "Para na primeira falha" },
        { "long": "--gtest_output", "arg": "xml:ARQUIVO", "description": "Relatório JUnit XML (para CI)" },
        { "long": "--gtest_brief", "arg": "1", "description": "Só mostra as falhas" },
        { "long": "--gtest_also_run_disabled_tests", "description": "Roda também os DISABLED_" },
        { "long": "--gtest_color", "arg": "yes|no|auto", "description": "Cores na saída" }
      ],
      "examples": [
        { "command": "./build/testes --gtest_filter=PedidoTest.*", "description": "Só a suíte PedidoTest" },
        { "command": "./build/testes --gtest_filter='*Pedido*-*Lento*'", "description": "Tudo com Pedido, menos os Lento" },
        { "command": "./build/testes --gtest_list_tests", "description": "Nomes dos testes" },
        { "command": "./build/testes --gtest_repeat=200 --gtest_break_on_failure --gtest_filter=Fila.Concorrente", "description": "Caça uma falha intermitente" },
        { "command": "./build/testes --gtest_output=xml:relatorio.xml", "description": "Relatório para o CI" },
        { "command": "GTEST_FILTER='PedidoTest.*' ctest --test-dir build -V", "description": "Filtro por variável de ambiente" }
      ],
      "sections": [
        {
          "title": "Macros",
          "rows": [
            ["TEST(Suite, Nome)", "um teste; o nome completo é Suite.Nome"],
            ["TEST_F(Fixture, Nome)", "teste com SetUp/TearDown de uma classe fixture"],
            ["EXPECT_EQ(a, b)", "falha, mas continua o teste"],
            ["ASSERT_EQ(a, b)", "falha e encerra o teste"],
            ["EXPECT_TRUE / EXPECT_FALSE", "condições"],
            ["EXPECT_NEAR(a, b, erro)", "números de ponto flutuante"],
            ["EXPECT_THROW(expr, Tipo)", "exceções"]
          ]
        }
      ],
      "related": ["ctest", "cmake", "gtest-run-one", "gtest-flaky"],
      "flag_prefix": "--gtest_"
    },
    {
      "name": "gdb",
      "kind": "command",
      "summary": "Depurador: roda o programa passo a passo e mostra onde ele quebrou",
      "usage": "gdb [--args] PROGRAMA [ARGS] | gdb -p PID",
      "install": "Debian/Ubuntu: sudo apt install gdb. Compile com -g para ver arquivos e linhas.",
      "aliases": ["depurar c++", "debugger", "backtrace", "core dump", "debugar"],
      "tags": ["c++", "depuração"],
      "options": [
        { "long": "--args", "description": "Tudo depois do programa vira argumento dele" },
        { "short": "-p", "arg": "PID", "description": "Anexa a um processo em execução" },
        { "short": "-ex", "arg": "COMANDO", "description": "Executa um comando do gdb ao iniciar" },
        { "short": "-batch", "description": "Sai ao terminar os comandos (-ex)" }
      ],
      "examples": [
        { "command": "gdb ./app", "description": "Abre; digite run para rodar" },
        { "command": "gdb --args ./app --porta 8080", "description": "Com argumentos" },
        { "command": "gdb -batch -ex run -ex bt ./app", "description": "Roda e mostra o backtrace se quebrar" },
        { "command": "gdb ./app core", "description": "Analisa um core dump" },
        { "command": "gdb -p 1234", "description": "Anexa a um processo travado" }
      ],
      "sections": [
        {
          "title": "Comandos",
          "rows": [
            ["run (r)", "roda o programa"],
            ["bt", "pilha de chamadas (backtrace)"],
            ["break arquivo.cpp:42 (b)", "ponto de parada"],
            ["next (n) / step (s)", "próxima linha / entra na função"],
            ["print var (p)", "mostra um valor"],
            ["continue (c)", "continua até o próximo ponto de parada"],
            ["quit (q)", "sai"]
          ]
        }
      ],
      "related": ["gpp", "valgrind", "cpp-debug-crash", "error-segfault"]
