    {
      "id": "kill-process-on-port",
      "name": "Liberar uma porta em uso",
      "kind": "recipe",
      "summary": "Encontrar e encerrar o processo que ocupa uma porta",
      "aliases": ["liberar porta", "porta em uso", "address already in use", "matar processo na porta", "kill port"],
      "tags": ["processos", "portas", "rede"],
      "examples": [
        { "command": "sudo ss -ltnp 'sport = :{{port:8080}}'", "description": "Mostra o processo dono da porta" },
        { "command": "sudo lsof -ti :{{port:8080}}", "description": "Só o PID" },
        { "command": "kill $(sudo lsof -ti :{{port:8080}})", "description": "Pede para encerrar o processo" },
        { "command": "sudo fuser -k {{port:8080}}/tcp", "description": "Alternativa com fuser" }
      ],
