    {
      "id": "cron-syntax",
      "name": "Sintaxe do cron",
      "kind": "concept",
      "summary": "Os cinco campos de um agendamento: minuto, hora, dia do mês, mês e dia da semana",
      "description": "Digite o agendamento (ex.: 0 3 * * 1) ou cron seguido dele para ver a explicação campo a campo.",
      "aliases": ["expressão cron", "cron expression", "* * * * *", "campos do cron", "crontab format", "@daily", "@reboot"],
      "tags": ["agendamento", "cron"],
